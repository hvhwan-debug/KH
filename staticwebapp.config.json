{
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/asm",
      "redirect": "/asm/",
      "statusCode": 301
    },
    {
      "route": "/asm/",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/asm/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ]
}