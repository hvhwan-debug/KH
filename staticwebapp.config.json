{
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".bin": "application/octet-stream",
    ".traineddata": "application/octet-stream"
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/asm/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/kiemtra/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/kiemtra/admin.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/kiemtra/ketqua.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/kiemtra/quanli.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/kiemtra/ks=*",
      "rewrite": "/kiemtra/ks.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/kiemtra/ks-admin",
      "rewrite": "/kiemtra/ks-admin.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/kiemtra/vendor/ocr/*",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/kiemtra/*",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/ai/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/ai",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
